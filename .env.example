# Copy to .env and fill in. Never commit .env.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing (optional, off by default: when on, questions, retrieved passages and
# answers are sent to LangSmith). LangGraph traces the agent automatically once this is set.
# LangChain reads the LANGCHAIN_* names.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=production-rag

# Hugging Face (optional): higher rate limits when downloading local models
HF_TOKEN=

# Shared model folder (GGUF LLMs and the fastembed cache). Default: .cache/models
# RAG_MODELS_DIR=../ai_models

# API service (`rag serve`); defaults shown
# RAG_DEMO_MODE=false                 # uploads/deletes/docs off, 500-char questions
# RAG_RATE_LIMIT_PER_MINUTE=20        # question endpoints, per client
# RAG_GENERAL_RATE_LIMIT_PER_MINUTE=120
# RAG_CACHE_TTL_S=300                 # raise it for a pre-warmed demo (D5)
# RAG_QUEUE_SIZE=1                    # questions that may wait behind the running one
# RAG_TRUSTED_PROXY_HEADER=cf-connecting-ip   # set when serving through cloudflared
# RAG_ADMIN_TOKEN=                    # if set, uploads/deletes need "Authorization: Bearer <token>"
