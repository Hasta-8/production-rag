# Copy to .env and fill in. Never commit .env.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing (optional, off by default: when on, questions, retrieved passages and
# answers are sent to LangSmith). LangGraph traces the agent automatically once this is set.
# LangChain reads the LANGCHAIN_* names.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=production-rag

# Hugging Face (optional): higher rate limits when downloading local models
HF_TOKEN=

# Shared model folder (GGUF LLMs and the fastembed cache). Default: .cache/models
# RAG_MODELS_DIR=../ai_models
